class Solution {
    int[][] d = new int[][]{
        {1, 0},
        {0, 1},
        {-1, 0},
        {0, -1}
    };
    public boolean seach(int i , int j , int index , char[][] board , String word ){

        if(index == word.length())return true;

        //vis[i][j] = true;

        char temp = board[i][j];
        board[i][j] = '#';

        for(int[] dir : d){

            int r = i + dir[0];
            int c = j + dir[1];

            if(r>=0 && c>=0 && r < board.length && c < board[0].length){
                if(board[r][c] == word.charAt(index) && board[r][c] != '#'){
                    if(seach(r,c,index+1,board,word))return true;
                }
            }

        }

        //vis[i][j] = false;
        board[i][j] = temp;

        return false;

    }
    public boolean exist(char[][] board, String word) {
        int n = board.length , m = board[0].length;
        //boolean[][] vis = new boolean[n][m];

        for(int i = 0 ; i <  n ; i++){
            for(int j = 0 ; j < m ; j++){
                if(word.charAt(0) == board[i][j]){
                    if(seach(i,j,1,board,word))return true;
                }
            }
        }

        return false;

    }
}
